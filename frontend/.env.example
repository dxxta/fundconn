# Address printed by `make deploy-dev` (or your production deployment)
VITE_CONTRACT_ADDRESS=
# JSON-RPC URL reachable from the browser (local node or public RPC)
VITE_NETWORK=http://127.0.0.1:8545
# IPFS gateway URL
VITE_IPFS=http://127.0.0.1:8080/ipfs

# true shows the top demo banner with the public Hardhat test key
VITE_DEMO=false
